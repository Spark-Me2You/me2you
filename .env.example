# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Settings
VITE_SESSION_TIMEOUT_MS=90000
VITE_GESTURE_COOLDOWN_MS=3000
VITE_IDLE_TIMEOUT_MS=30000
VITE_TARGET_FPS=24

# Gumball Slice (optional overrides; defaults in src/features/games/gumballslice/config/gumballSliceConfig.ts)
# VITE_GUMBALL_ROUND_SECONDS=60
# VITE_GUMBALL_MIN_SLICES=25
# VITE_GUMBALL_CANDY_SPEED=1
# VITE_GUMBALL_BAD_ITEM_FREQUENCY=0.15
# VITE_GUMBALL_SLICE_SPEED=1.3
# VITE_GUMBALL_HITBOX_SCALE=1.35
# VITE_GUMBALL_TRAIL_LIFETIME_MS=350
# VITE_GUMBALL_TRAIL_WIDTH=0.03
# VITE_GUMBALL_TRAIL_SMOOTHING=0.35
# VITE_GUMBALL_SEATED_MODE=false

# Development
VITE_ENABLE_LOGGER=true
VITE_ENABLE_PERFORMANCE_MONITOR=true

# Registration (MVP1)
VITE_DEFAULT_ORG_ID=your-org-uuid-here
